# Copy to server/.env and fill in. Never commit server/.env.

# OpenAI: one key covers speech-to-text, chat, and embeddings
OPENAI_API_KEY=
LLM_MODEL=
# Optional, default none (none|low|medium|high); empty string omits the parameter
# LLM_REASONING_EFFORT=none
# Optional, default gpt-4o-mini-transcribe
STT_MODEL=

# Optional mic / turn-taking tuning (defaults shown)
# MIC_SOURCE=local              # local = PortAudio; browser = PCM over WebSocket (N4)
# MIC_CHUNK_MS=30               # browser uplink chunk size; pushed to client via mic_config
# CHAT_WS_HOST=127.0.0.1        # 0.0.0.0 for LAN phone stretch
# VAD_THRESHOLD_MULTIPLIER=3.0
# VAD_MIN_THRESHOLD=200
# VAD_START_FRAMES=3
# VAD_SILENCE_END_MS=1200
# VAD_MIN_UTTERANCE_SECONDS=0.3
# VAD_DEBUG=1
# ECHO_TAIL_SECONDS=0.3

# ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional voice tuning (defaults shown)
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# ELEVENLABS_SPEED=0.8
# ELEVENLABS_STABILITY=0.75
# ELEVENLABS_SIMILARITY_BOOST=0.85
# ELEVENLABS_STYLE=0.1
# ELEVENLABS_SPEAKER_BOOST=true

# Optional N1 latency CSV path (default ../findings/data/N1-baseline-<date>.csv)
# METRICS_CSV=../findings/data/N2-after-2026-11-20.csv

# Optional networking toggles (defaults shown)
# HTTP_KEEPALIVE_SECONDS=300   # keep OpenAI / Supabase / ElevenLabs connections open between turns
# WS_AUDIO_BINARY=1            # 0 = legacy base64-in-JSON audio
# WS_COMPRESSION=0             # 1 = permessage-deflate (the pre-N2 behavior)
# TTS_STREAMING=1              # N3a: stream TTS chunks over the WS (0 = one full clip, the N2 behavior)
# LLM_STREAMING=1              # N3b: stream reply text, TTS per sentence (needs TTS_STREAMING=1)

# Supabase memory (project root URL, no /rest/v1)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
